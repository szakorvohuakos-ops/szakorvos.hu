<?xml version="1.0" encoding="UTF-8"?>
<!--
  Statikus sitemap fallback.
  Normál üzemben a /sitemap.xml URL-t a Vercel rewrite a Supabase Edge
  Function-re (seo-render/sitemap) routeolja, ami dinamikus tartalmat ad
  vissza az adatbázisból. Ez a fájl csak akkor szolgálódik ki, ha:
    - az Edge Function le van állítva
    - vagy direkt /sitemap-static.xml-t kérnek
-->
